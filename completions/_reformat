#compdef reformat.tcl

_arguments \
  '*:filename:_files' \
  '(-indent --indent)'{-indent,--indent}'[Indent width in spaces]:indent:' \
  '--indent=[Indent width in spaces]:indent:' \
  '(-noalign --noalign)'{-noalign,--noalign}'[Disable inline comment alignment]' \
  '(-align --align)'{-align,--align}'[Enable inline comment alignment]' \
  '--stdin[Read Tcl from stdin (implies --stdout)]' \
  '--stdout[Write formatted Tcl to stdout]' \
  '--indent-commented-code[Indent commented-out code blocks]' \
  '(-V --version)'{-V,--version}'[Show version]' \
  '(-h --help)'{-h,--help}'[Show help]'
